# services/ollama-openwebui/.env.example — documentation only, not read at runtime.
# setup.sh renders ~/docker/ollama-openwebui/.env from .env.template and then
# manages COMPOSE_FILE / DOMAIN. Everything else is yours to tune.
WEBUI_SECRET_KEY=generated-by-setup
ENABLE_SIGNUP=false
COMPOSE_FILE=docker-compose.yml:docker-compose.lock.yml
# OLLAMA_MEM_LIMIT=8g
# OLLAMA_CPUS=4
# OLLAMA_KEEP_ALIVE=30m
# OLLAMA_NUM_PARALLEL=1
# OLLAMA_MAX_LOADED_MODELS=1
# OLLAMA_CONTEXT_LENGTH=8192
