# Traefik static config — HTTPS mode. Rendered by setup.sh to
# ~/docker/traefik/traefik.yml when ENABLE_HTTPS=true (whitelist: $ACME_EMAIL).
# Both entrypoints listen only on the Tailscale IP (see the compose files).

global:
  checkNewVersion: false
  sendAnonymousUsage: false

entryPoints:
  web:
    address: ":80"
    http:
      middlewares:
        - default-headers-base@file
        - internal-only@file
  websecure:
    address: ":443"
    http:
      middlewares:
        - default-headers-base@file
        - default-headers-hsts@file
        - internal-only@file

certificatesResolvers:
  letsencrypt:
    acme:
      email: "${ACME_EMAIL}"
      storage: /letsencrypt/acme.json
      dnsChallenge:
        provider: ovh

providers:
  docker:
    endpoint: "tcp://docker-socket-proxy:2375"
    exposedByDefault: false
    network: proxy-net
  file:
    directory: /etc/traefik/dynamic
    watch: true

api:
  dashboard: true
  insecure: false

ping: {}

log:
  level: INFO

accessLog: {}
