# Example of ~/.config/devbox/config.env (mode 0600), for reference only.
#
# setup.sh upserts the keys below on every run and leaves any other keys you
# add untouched. On re-runs it reads its keys back as defaults; the matching
# environment variable (in parentheses) overrides them. The file is parsed
# with sed and never sourced: one KEY=value per line, no quotes, no expansion.

# Operator account. Informational: re-runs take the operator from the
# root-owned /etc/devbox/operator, or from DEVBOX_USER.
DEVBOX_USER=dev

# sshd port; also allowed in UFW and the fail2ban jail (DEVBOX_SSH_PORT).
SSH_PORT=5522

# true = Traefik also serves HTTPS on the Tailscale IP with Let's Encrypt
# certificates via OVH DNS-01 (ENABLE_HTTPS).
ENABLE_HTTPS=false

# HTTPS only: routers for ai.<DOMAIN> and ollama.<DOMAIN> (DEVBOX_DOMAIN),
# and the Let's Encrypt account email (DEVBOX_EMAIL).
DOMAIN=
ACME_EMAIL=

# none | nvidia. nvidia chains the Ollama GPU overlay (DEVBOX_GPU).
GPU=none

# The Tailscale IPv4 address services were bound to at the last run, or
# 127.0.0.1 with DEVBOX_ALLOW_NO_TAILSCALE=true. Detected, not configured.
TAILSCALE_IP=100.64.0.1

# Optional operator key, read by backup.sh: GPG recipient used when
# ~/.config/devbox/age-recipients.txt is absent (age is preferred).
# BACKUP_GPG_RECIPIENT=you@example.com
