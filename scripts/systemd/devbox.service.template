[Unit]
Description=DevBox stack (Traefik, Ollama, Open WebUI)
Requires=docker.service
After=docker.service network-online.target tailscaled.service
Wants=network-online.target

[Service]
Type=oneshot
RemainAfterExit=yes
User=${DEVBOX_USER}
ExecStart=${DEVBOX_HOME}/start-all.sh
ExecStop=${DEVBOX_HOME}/stop-all.sh
TimeoutStartSec=600
TimeoutStopSec=180

[Install]
WantedBy=multi-user.target
