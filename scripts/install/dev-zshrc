# DevBox — dev user .zshrc
# Installed by setup.sh from scripts/install/dev-zshrc. Re-running setup.sh
# replaces it (the previous copy is kept in ~/.local/share/devbox/backups/);
# remove this first line to make the file yours and stop that.

# Oh-My-Zsh
export ZSH="$HOME/.oh-my-zsh"
ZSH_THEME="robbyrussell"
plugins=(git docker docker-compose)
# Pinned by setup.sh (scripts/lib/pins.sh); update by bumping the pin.
zstyle ':omz:update' mode disabled
source $ZSH/oh-my-zsh.sh

# ─── mise: node, bun, rust, uv, neovim, lazygit, zellij, exegol… ─────────────
if command -v mise &>/dev/null; then
    eval "$(mise activate zsh)"
fi
# Global installs (`bun add -g`, `cargo install`) keep their usual homes.
export PATH="$HOME/.bun/bin:$HOME/.cargo/bin:$PATH"

# ─── Docker Aliases ──────────────────────────────────────────────────────────
alias d="docker"
alias dc="docker compose"
alias dps="docker ps --format 'table {{.Names}}\t{{.Status}}\t{{.Ports}}'"
alias dpsa="docker ps -a --format 'table {{.Names}}\t{{.Status}}\t{{.Ports}}'"
alias dlog="docker logs -f"
alias dex="docker exec -it"
alias dprune="docker system prune -af"

# ─── Ollama ─────────────────────────────────────────────────────────────────
alias ollama='docker exec -it ollama ollama'
alias olist='docker exec -it ollama ollama list'
alias opull='docker exec -it ollama ollama pull'
alias orm='docker exec -it ollama ollama rm'
alias oshow='docker exec -it ollama ollama show'
alias ocopy='docker exec -it ollama ollama cp'
alias ollama-health='docker exec ollama ollama list'
alias ollama-ps='docker ps -f "name=ollama" --format "table {{.Names}}\t{{.Status}}\t{{.Ports}}"'

# ─── Git Aliases ─────────────────────────────────────────────────────────────
alias lg="lazygit"
alias gs="git status"
alias gp="git pull"
alias gP="git push"

# ─── Editor ──────────────────────────────────────────────────────────────────
alias vim="nvim"
alias vi="nvim"

# ─── Terminal Multiplexer ─────────────────────────────────────────────────────
alias zj="zellij"

# ─── Claude ─────
alias cc="claude -c"
alias ccd="claude -c --dangerously-skip-permissions"

# ─── DevBox helpers (~/docker) ───────────────────────────────────────────────
alias start-all="~/docker/start-all.sh"
alias stop-all="~/docker/stop-all.sh"
alias status="~/docker/status.sh"
alias exegol-up="~/docker/exegol-start.sh"
alias exegol-reset="~/docker/exegol-reset-vnc.sh"
alias exegol-list="exegol info"
alias htb-vpn="~/docker/htb-vpn.sh"
alias security-check="~/docker/security-check.sh"
alias devbox-backup="~/docker/backup.sh"
alias devbox-restore="~/docker/restore.sh"
alias devbox-diagnose="~/docker/diagnose.sh"

# ─── Tailscale ───────────────────────────────────────────────────────────────
alias ts="tailscale"
alias tsip="tailscale ip -4"
alias tsstatus="tailscale status"
alias tsup="sudo tailscale up"
alias tsdown="sudo tailscale down"

# ─── Navigation ──────────────────────────────────────────────────────────────
alias dock="cd ~/docker"
alias proj="cd ~/projects"
alias htb="cd ~/htb"

# ─── Utilities ───────────────────────────────────────────────────────────────
alias ll="ls -lahF"
alias la="ls -A"
alias l="ls -CF"
alias ..="cd .."
alias ...="cd ../.."
alias grep="grep --color=auto"
alias cheat='f(){ curl -s "cheat.sh/$1";  unset -f f; }; f'

# ─── History ─────────────────────────────────────────────────────────────────
HISTSIZE=10000
SAVEHIST=10000
setopt SHARE_HISTORY
setopt HIST_IGNORE_DUPS

# ─── Welcome Message ─────────────────────────────────────────────────────────
echo ""
echo "DevBox — start-all | stop-all | status | security-check"
echo "         exegol-up | htb-vpn | devbox-backup | devbox-restore"
echo ""
